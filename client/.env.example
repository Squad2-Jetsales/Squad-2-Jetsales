# Copie para .env.local em desenvolvimento. NUNCA commite o .env.local.

# URL base do backend Express. Não termina com barra.
#
# Local (dev):  http://localhost:3001
#               (requisições vão direto pro Express na porta 3001)
#
# Produção (Vercel): DEIXE VAZIO.
#                    O vercel.json reescreve /api/* pro Render no edge,
#                    fazendo as requests virarem first-party do domínio
#                    da Vercel — cookies cross-site deixam de ser bloqueados
#                    pelo Chrome/Firefox/Edge. Por isso a env não é mais
#                    necessária em produção.
VITE_API_BASE_URL=http://localhost:3001
