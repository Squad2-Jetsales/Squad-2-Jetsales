# Copie para .env.local em desenvolvimento. NUNCA commite o .env.local.
#
# Em produção (Vercel), configure VITE_API_BASE_URL em
#   Vercel Dashboard → Settings → Environment Variables
# apontando para a URL pública do backend (ex.: Render).
# Após adicionar/alterar a variável, é preciso re-deployar.

# URL base do backend Express. Não termina com barra.
# Local:     http://localhost:3001
# Produção:  https://<seu-backend>.onrender.com
VITE_API_BASE_URL=http://localhost:3001
