# Copie para .env e ajuste para o seu ambiente.
# Em produção (Render/Fly/etc.), configure as mesmas variáveis no painel do
# provedor — NUNCA commite secrets.

# ───────── Local ─────────
NODE_ENV=development
PORT=3001

# Database (Postgres) — bate com docker-compose.yaml
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jetsales

# ───────── Produção (Render etc.) ─────────
# Quando NODE_ENV=production, o knexfile usa DATABASE_URL (com SSL ligado).
# Render: copie a "Internal Database URL" do banco gerenciado.
# DATABASE_URL=postgres://user:pass@host:5432/db

# JWT — gere com: openssl rand -hex 64
JWT_ACCESS_SECRET=troque-isto-em-producao-access
JWT_REFRESH_SECRET=troque-isto-em-producao-refresh

# CORS — origins do front separados por vírgula
# Local: http://localhost:8080
# Produção: https://seu-frontend.vercel.app
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Domínio dos cookies (apenas se quiser cookies cross-subdomain).
# Para Vercel + Render (domínios diferentes), DEIXE VAZIO.
# COOKIE_DOMAIN=.jetsales.com.br

# Token secreto para a rota /api/v1/setup/seed (criar admin em prod uma vez).
# Defina um valor forte em prod; em dev pode deixar vazio (rota retorna 500).
# SETUP_SECRET=

# Evolution API
# URL base da API, sem barra final.
EVOLUTION_API_BASE_URL=http://localhost:8080
# Chave enviada no header `apikey`.
EVOLUTION_API_KEY=
# Instancia padrao opcional para status/testes administrativos.
EVOLUTION_API_INSTANCE=
# Segredo validado no webhook recebido pelo backend.
EVOLUTION_WEBHOOK_SECRET=
# URL publica do webhook do backend.
EVOLUTION_WEBHOOK_URL=http://localhost:3001/api/v1/webhooks/evolution

# Compatibilidade com nomes antigos (legado). Deixe vazios em novos ambientes.
# EVOLUTION_API_URL=
# EVOLUTION_WEBHOOK_TOKEN=

# ───────── AI providers (Fase 3) ─────────

# Provider para CHAT do agente: 'anthropic' (recomendado p/ PT-BR) ou 'openai'
AI_CHAT_PROVIDER=anthropic
AI_CHAT_MODEL=claude-sonnet-4-6

# Provider para EMBEDDINGS (default OpenAI; mantém qualidade alta com baixo custo)
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536

# API keys — preencher conforme o provider escolhido
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Parâmetros default do agente (podem ser sobrescritos por chatbot.aiConfig)
AI_TEMPERATURE_DEFAULT=0.3
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_AGENT_ITERATIONS=4

# RAG
RAG_TOP_K_RETRIEVE=20
RAG_TOP_K_RETURN=6
RAG_MIN_SIMILARITY=0.25

# Tabela de preços (USD por 1M tokens). Atualize conforme provider.
# Anthropic Sonnet 4.6: $3 input / $15 output (referência 2026-06)
COST_ANTHROPIC_INPUT_PER_1M=3.00
COST_ANTHROPIC_OUTPUT_PER_1M=15.00
# OpenAI gpt-4o-mini: $0.15 / $0.60 (referência)
COST_OPENAI_INPUT_PER_1M=0.15
COST_OPENAI_OUTPUT_PER_1M=0.60
# Embeddings text-embedding-3-small: $0.02 / 1M
COST_OPENAI_EMBED_PER_1M=0.02

# Rate limit por organização (token bucket em memória; Redis vem na F3.7)
AI_RPM_DEFAULT=30
AI_MONTHLY_TOKEN_CAP_DEFAULT=2000000
